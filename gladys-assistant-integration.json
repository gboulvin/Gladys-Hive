      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Heating zone (first one if empty)",
            "fr": "Zone de chauffage (la première si vide)",
            "de": "Heizzone (die erste, wenn leer)",
            "es": "Zona de calefacción (la primera si está vacío)"
          }
        }
      ],
      "outputs": [
        {
          "key": "cancelled",
          "type": "boolean",
          "label": {
            "en": "A boost was cancelled",
            "fr": "Un boost a été annulé",
            "de": "Ein Boost wurde beendet",
            "es": "Se ha cancelado un boost"
          }
        }
      ]
    },
