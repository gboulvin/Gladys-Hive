{
  "manifest_version": 1,
  "type": "device",
  "name": "Hive",
  "description": {
    "en": "Control Hive heating, hot water, lights, plugs and sensors from Gladys.",
    "fr": "Pilotez chauffage, eau chaude, lampes, prises et capteurs Hive depuis Gladys.",
    "de": "Steuern Sie Hive-Heizung, Warmwasser, Lampen, Steckdosen und Sensoren.",
    "es": "Controle la calefacción, el agua caliente, luces, enchufes y sensores Hive."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/gboulvin/gladys-hive:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-Hive/main/cover.png",
  "categories": ["climate", "lighting", "security"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Hive account",
        "fr": "Votre compte Hive",
        "de": "Ihr Hive-Konto",
        "es": "Su cuenta Hive"
      },
      "description": {
        "en": "Sign in with the email and password of the Hive app. Hive usually confirms a new login with a code sent by SMS: when the connection status asks for it, type the code below and save within 3 minutes. Gladys is then remembered by your Hive account and no longer needs a code.",
        "fr": "Connectez-vous avec l'e-mail et le mot de passe de l'application Hive. Hive confirme généralement une nouvelle connexion par un code envoyé par SMS : quand l'état de connexion le demande, saisissez le code ci-dessous et enregistrez sous 3 minutes. Gladys est ensuite mémorisé par votre compte Hive et n'a plus besoin de code.",
        "de": "Melden Sie sich mit der E-Mail-Adresse und dem Passwort der Hive-App an. Hive bestätigt eine neue Anmeldung meist mit einem per SMS gesendeten Code: Wenn der Verbindungsstatus danach fragt, geben Sie den Code unten ein und speichern Sie innerhalb von 3 Minuten. Danach merkt sich Ihr Hive-Konto Gladys und braucht keinen Code mehr.",
        "es": "Inicie sesión con el correo electrónico y la contraseña de la aplicación Hive. Hive suele confirmar un nuevo inicio de sesión con un código enviado por SMS: cuando el estado de conexión lo pida, escriba el código abajo y guarde en menos de 3 minutos. Después, su cuenta Hive recuerda Gladys y ya no necesita código."
      },
      "links": [
        {
          "url": "https://my.hivehome.com/",
          "label": {
            "en": "Hive web app",
            "fr": "Application web Hive",
            "de": "Hive-Web-App",
            "es": "Aplicación web de Hive"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Hive email",
        "fr": "E-mail Hive",
        "de": "Hive-E-Mail",
        "es": "Correo electrónico de Hive"
      },
      "placeholder": {
        "en": "e.g. me@example.com",
        "fr": "ex. moi@exemple.fr",
        "de": "z. B. ich@beispiel.de",
        "es": "p. ej. yo@ejemplo.es"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Hive password",
        "fr": "Mot de passe Hive",
        "de": "Hive-Passwort",
        "es": "Contraseña de Hive"
      },
      "required": true
    },
    {
      "key": "sms_code",
      "type": "string",
      "label": {
        "en": "SMS code",
        "fr": "Code SMS",
        "de": "SMS-Code",
        "es": "Código SMS"
      },
      "description": {
        "en": "Only when the connection status asks for it: the code Hive sent by SMS.",
        "fr": "Seulement si l'état de connexion le demande : le code envoyé par SMS par Hive.",
        "de": "Nur wenn der Verbindungsstatus danach fragt: der von Hive per SMS gesendete Code.",
        "es": "Solo si el estado de conexión lo pide: el código que Hive envió por SMS."
      },
      "placeholder": {
        "en": "e.g. 123456",
        "fr": "ex. 123456",
        "de": "z. B. 123456",
        "es": "p. ej. 123456"
      },
      "required": false
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often Gladys reads the Hive cloud. Sensors are seen with this delay.",
        "fr": "Fréquence de lecture du cloud Hive. Les capteurs sont vus avec ce délai.",
        "de": "Wie oft Gladys die Hive-Cloud liest. Sensoren werden mit dieser Verzögerung erkannt.",
        "es": "Frecuencia de lectura de la nube Hive. Los sensores se ven con este retraso."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "boost_duration",
      "type": "number",
      "label": {
        "en": "Default boost duration (min)",
        "fr": "Durée du boost par défaut (min)",
        "de": "Standard-Boost-Dauer (Min.)",
        "es": "Duración del boost por defecto (min)"
      },
      "required": false,
      "default": 30,
      "min": 15,
      "max": 360
    },
    {
      "key": "boost_temperature",
      "type": "number",
      "label": {
        "en": "Default heating boost temperature (°C)",
        "fr": "Température du boost chauffage par défaut (°C)",
        "de": "Standard-Boost-Temperatur Heizung (°C)",
        "es": "Temperatura del boost de calefacción por defecto (°C)"
      },
      "required": false,
      "default": 21,
      "min": 5,
      "max": 32
    },
    {
      "key": "battery_low_threshold",
      "type": "number",
      "label": {
        "en": "Low battery threshold (%)",
        "fr": "Seuil de batterie faible (%)",
        "de": "Schwelle für schwache Batterie (%)",
        "es": "Umbral de batería baja (%)"
      },
      "required": false,
      "default": 20,
      "min": 5,
      "max": 50
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    },
    {
      "key": "refresh_devices",
      "label": {
        "en": "Refresh the Hive devices",
        "fr": "Actualiser les appareils Hive",
        "de": "Hive-Geräte aktualisieren",
        "es": "Actualizar los dispositivos Hive"
      },
      "timeout_seconds": 60
    },
    {
      "key": "forget_session",
      "label": {
        "en": "Forget the Hive session",
        "fr": "Oublier la session Hive",
        "de": "Hive-Sitzung vergessen",
        "es": "Olvidar la sesión de Hive"
      },
      "timeout_seconds": 60
    }
