  "scene_actions": [
    {
      "key": "boost_heating",
      "label": {
        "en": "Boost the Hive heating",
        "fr": "Booster le chauffage Hive",
        "de": "Hive-Heizung boosten",
        "es": "Activar boost de calefacción Hive"
      },
      "description": {
        "en": "Heat a zone to a temperature for a while, then go back to its mode.",
        "fr": "Chauffe une zone à une température pendant un temps, puis revient à son mode.",
        "de": "Heizt eine Zone eine Zeit lang auf eine Temperatur und kehrt dann zum Modus zurück.",
        "es": "Calienta una zona a una temperatura durante un tiempo y vuelve a su modo."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Heating zone (first one if empty)",
            "fr": "Zone de chauffage (la première si vide)",
            "de": "Heizzone (die erste, wenn leer)",
            "es": "Zona de calefacción (la primera si está vacío)"
          }
        },
        {
          "key": "duration",
          "type": "number",
          "label": {
            "en": "Duration (min)",
            "fr": "Durée (min)",
            "de": "Dauer (Min.)",
            "es": "Duración (min)"
          },
          "default": 30,
          "min": 15,
          "max": 360
        },
        {
          "key": "temperature",
          "type": "number",
          "label": {
            "en": "Temperature (°C)",
